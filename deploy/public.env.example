POSTGRES_DB=isite2_public
POSTGRES_USER=isite
POSTGRES_PASSWORD=change-this-long-random-password

ISITE2_PUBLIC_DOMAIN=isite2.example.com
ISITE2_BASIC_AUTH_USER=client
# Generate with: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
# When pasting a bcrypt hash in this env file, escape each "$" as "$$" for Docker Compose.
ISITE2_BASIC_AUTH_HASH=replace-with-caddy-hash-password-output
