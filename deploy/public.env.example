POSTGRES_DB=isite2_public
POSTGRES_USER=isite
POSTGRES_PASSWORD=change-this-long-random-password
ISITE2_OPS_DB=isite2_ops

ISITE2_PUBLIC_DOMAIN=isite2.example.com
ISITE2_APP_AUTH_ENABLED=1
ISITE2_APP_AUTH_USER=visitor
ISITE2_APP_AUTH_PASSWORD=visitor123456
# Generate with: openssl rand -hex 32
ISITE2_APP_AUTH_SECRET=replace-with-random-hex-secret
ISITE2_GUEST_CLICK_LIMIT=10
ISITE2_SERVICE_REQUESTS_ENABLED=1
ISITE2_SERVICE_REQUEST_DAILY_LIMIT=10
# Generate with: openssl rand -hex 32
ISITE2_REQUEST_ADMIN_TOKEN=replace-with-random-admin-token
ISITE2_FEATURE_EXPORTS_ENABLED=1
ISITE2_TRAFFIC_MODEL_VERSION=v2
# Keep disabled until Ookla license/product-use review is complete.
ISITE2_PUBLIC_OOKLA_ENABLED=0
# Optional POC allowlist. Example: Brazil
ISITE2_PUBLIC_OOKLA_COUNTRY_ALLOWLIST=
# Placer.ai footfall layer. Keep the key server-side; runtime config never exposes it.
PLACER_API_KEY=
PLACER_BASE_URL=https://papi.placer.ai
PLACER_FOOTFALL_ENDPOINT_TEMPLATE=
